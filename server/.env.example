PORT=3001

# Postgres connection string.
# - Local / Railway: postgresql://user:password@localhost:5432/chatapp
# - Neon (recommended, scales to zero when idle): copy the "Connection string"
#   from your Neon project dashboard. It already includes `?sslmode=require`,
#   which server/db.js detects automatically to enable SSL - no other change
#   needed. Prefer Neon's *pooled* connection string (the one with
#   `-pooler` in the hostname) since this app holds a socket.io server with
#   many concurrent DB queries, and Neon's direct (non-pooled) connections
#   have a low concurrent-connection limit on the free tier.
DATABASE_URL=postgresql://user:password@localhost:5432/chatapp

# Redis connection string.
# - Local / Railway: redis://localhost:6379
# - Upstash (recommended, pay-per-request/free tier): use the "ioredis" /
#   TCP connection string from your Upstash Redis database (starts with
#   `rediss://`, not the REST URL/token). This app uses plain key/value and
#   set commands (get/set/sadd/smembers/srem/del, keys) - no pub/sub - so
#   the TCP endpoint is a drop-in swap with no code changes required.
REDIS_URL=redis://localhost:6379

CLIENT_URL=http://localhost:5173

# Optional: enables "Sign in with Google" via Clerk alongside the nickname
# flow. Leave unset to run anon-only. Get both from your Clerk dashboard's
# API Keys page, and enable Google under User & Authentication -> Social
# Connections on that same Clerk application.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Cloudinary connection string for image uploads.
# Copy the "API environment variable" value from your Cloudinary dashboard -
# it bundles cloud name, API key, and API secret into one string, and the
# Node SDK auto-configures from it with no extra config code needed.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
